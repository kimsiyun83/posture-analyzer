// Full platform schema. Provider is PostgreSQL for production (Vercel Postgres/Neon/etc,
// pointed at by DATABASE_URL) — was SQLite for zero-cost local/dev during initial build.
// No enums are used (kept consistent with the original SQLite-compatible design) —
// allowed values are documented per field and enforced in the app layer via TypeScript
// literal unions in lib/types.ts.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Staff accounts (trainers/admins) ----------
// Members do NOT get login accounts in this build — this is a staff-facing CRM/PT
// tool, not a member self-service portal (kept the "member portal" part of the
// original spec out of scope; see project notes).

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String // "admin" | "trainer"
  phone        String?
  specialty    String? // e.g. "PT", "필라테스", "패시브 스트레칭"
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  membersCreated    Member[]           @relation("MemberCreatedBy")
  painRecords       PainRecord[]
  payments          Payment[]
  attendanceAsStaff Attendance[]
  reservations      Reservation[]
  bodyAssessments   BodyAssessment[]
  postureResults    PostureResult[]
  inbodyResults     InbodyResult[]
  romRecords        RomRecord[]
  exerciseLogs      ExerciseLog[]
  pilatesRecords    PilatesRecord[]
  stretchLogs       StretchLog[]
  aiReports         AiReport[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  naverAdAccountsCreated NaverAdAccount[]
}

// ---------- Members (clients) ----------

model Member {
  id              String   @id @default(cuid())
  name            String
  phone           String?
  email           String?
  birthDate       DateTime?
  gender          String? // "M" | "F" | "OTHER"
  joinedAt        DateTime @default(now())
  memo            String?
  medicalHistory  String? // free text: past injuries/surgeries/conditions
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdByUserId String?
  createdBy       User?    @relation("MemberCreatedBy", fields: [createdByUserId], references: [id])

  packages        MembershipPackage[]
  payments        Payment[]
  attendance      Attendance[]
  reservations    Reservation[]
  painRecords     PainRecord[]
  bodyAssessments BodyAssessment[]
  postureResults  PostureResult[]
  inbodyResults   InbodyResult[]
  romRecords      RomRecord[]
  exerciseLogs    ExerciseLog[]
  personalRecords PersonalRecord[]
  pilatesRecords  PilatesRecord[]
  stretchLogs     StretchLog[]
  nutritionLogs   NutritionLog[]
  aiReports       AiReport[]

  @@index([name])
}

model PainRecord {
  id            String   @id @default(cuid())
  memberId      String
  member        Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  bodyPart      String
  description   String?
  severity      Int // 1-10
  recordedAt    DateTime @default(now())
  recordedById  String?
  recordedBy    User?    @relation(fields: [recordedById], references: [id])

  @@index([memberId])
}

// ---------- Packages, payments, attendance, reservations ----------

model MembershipPackage {
  id                String   @id @default(cuid())
  memberId          String
  member            Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  name              String
  sessionType       String // "PT" | "PILATES" | "STRETCHING" | "MIXED"
  totalSessions     Int?
  remainingSessions Int?
  startDate         DateTime @default(now())
  endDate           DateTime?
  price             Float
  createdAt         DateTime @default(now())

  payments     Payment[]
  reservations Reservation[]

  @@index([memberId])
}

model Payment {
  id             String              @id @default(cuid())
  memberId       String
  member         Member              @relation(fields: [memberId], references: [id], onDelete: Cascade)
  packageId      String?
  package        MembershipPackage?  @relation(fields: [packageId], references: [id])
  amount         Float
  method         String // "CASH" | "CARD" | "TRANSFER" | "OTHER"
  memo           String?
  paidAt         DateTime            @default(now())
  recordedById   String?
  recordedBy     User?               @relation(fields: [recordedById], references: [id])

  @@index([memberId])
  @@index([paidAt])
}

model Attendance {
  id            String    @id @default(cuid())
  memberId      String
  member        Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  sessionType   String // "PT" | "PILATES" | "STRETCHING"
  checkedInAt   DateTime  @default(now())
  checkedOutAt  DateTime?
  staffId       String?
  staff         User?     @relation(fields: [staffId], references: [id])

  @@index([memberId])
  @@index([checkedInAt])
}

model Reservation {
  id               String             @id @default(cuid())
  memberId         String
  member           Member             @relation(fields: [memberId], references: [id], onDelete: Cascade)
  trainerId        String?
  trainer          User?              @relation(fields: [trainerId], references: [id])
  packageId        String?
  package          MembershipPackage? @relation(fields: [packageId], references: [id])
  sessionType      String // "PT" | "PILATES" | "STRETCHING"
  scheduledAt      DateTime
  durationMinutes  Int                @default(60)
  status           String             @default("SCHEDULED") // SCHEDULED | COMPLETED | CANCELLED | NO_SHOW
  memo             String?
  createdAt        DateTime           @default(now())

  @@index([memberId])
  @@index([scheduledAt])
}

// ---------- Assessments ----------

model BodyAssessment {
  id             String   @id @default(cuid())
  memberId       String
  member         Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  heightCm       Float?
  weightKg       Float?
  bodyFatPercent Float?
  muscleMassKg   Float?
  bmi            Float?
  measuredAt     DateTime @default(now())
  recordedById   String?
  recordedBy     User?    @relation(fields: [recordedById], references: [id])

  @@index([memberId])
}

// Reuses the existing MediaPipe-based posture screening (front+side photo ->
// angles/offsets) — now attached to a member so results can be tracked over time
// instead of being a one-off anonymous session.
model PostureResult {
  id            String   @id @default(cuid())
  memberId      String
  member        Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  programType   String // "pilates" | "stretching" | "pt"
  frontScore    Int
  sideScore     Int
  metricsJson   Json // full Reading[] output from lib/pose/metrics.ts
  measuredAt    DateTime @default(now())
  recordedById  String?
  recordedBy    User?    @relation(fields: [recordedById], references: [id])

  @@index([memberId])
}

model InbodyResult {
  id                 String   @id @default(cuid())
  memberId           String
  member             Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  weightKg           Float?
  skeletalMuscleKg   Float?
  bodyFatMassKg      Float?
  bodyFatPercent     Float?
  bmi                Float?
  visceralFatLevel   Float?
  ocrRawText         String? // raw Tesseract.js OCR output, kept for audit/debugging
  ocrConfidence      Float?
  measuredAt         DateTime @default(now())
  recordedById       String?
  recordedBy         User?    @relation(fields: [recordedById], references: [id])

  @@index([memberId])
}

model RomRecord {
  id            String   @id @default(cuid())
  memberId      String
  member        Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  joint         String // e.g. "고관절", "어깨", "발목"
  movement      String // e.g. "굴곡", "신전", "회전"
  degreeBefore  Float?
  degreeAfter   Float?
  measuredAt    DateTime @default(now())
  recordedById  String?
  recordedBy    User?    @relation(fields: [recordedById], references: [id])

  @@index([memberId])
}

// ---------- PT ----------

model ExerciseLog {
  id          String   @id @default(cuid())
  memberId    String
  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  exerciseName String
  setsJson    Json // [{ reps, weightKg, rpe? }]
  sessionDate DateTime @default(now())
  trainerId   String?
  trainer     User?    @relation(fields: [trainerId], references: [id])
  notes       String?

  @@index([memberId])
}

model PersonalRecord {
  id           String   @id @default(cuid())
  memberId     String
  member       Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  exerciseName String
  value        Float
  unit         String // "kg" | "reps" | "sec"
  achievedAt   DateTime @default(now())

  @@index([memberId])
}

// ---------- Pilates ----------

model PilatesRecord {
  id           String   @id @default(cuid())
  memberId     String
  member       Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  equipment    String // "REFORMER" | "CADILLAC" | "CHAIR" | "BARREL" | "MAT"
  level        String // "BEGINNER" | "INTERMEDIATE" | "ADVANCED"
  exercisesJson Json // [{ name, reps/duration, notes }]
  classDate    DateTime @default(now())
  trainerId    String?
  trainer      User?    @relation(fields: [trainerId], references: [id])
  notes        String?

  @@index([memberId])
}

// ---------- Passive stretching ----------

model StretchLog {
  id          String   @id @default(cuid())
  memberId    String
  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  bodyPart    String
  intensity   Int // 1-5
  romBefore   Float?
  romAfter    Float?
  painBefore  Int? // 0-10
  painAfter   Int? // 0-10
  sessionDate DateTime @default(now())
  trainerId   String?
  trainer     User?    @relation(fields: [trainerId], references: [id])
  notes       String?

  @@index([memberId])
}

// ---------- Nutrition / AI ----------

model NutritionLog {
  id          String   @id @default(cuid())
  memberId    String
  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  mealType    String? // "breakfast" | "lunch" | "dinner" | "snack"
  description String
  estCalories Int?
  recordedAt  DateTime @default(now())
  aiGenerated Boolean  @default(false)

  @@index([memberId])
}

model AiReport {
  id            String   @id @default(cuid())
  memberId      String
  member        Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  type          String // "CONSULTATION_NOTE" | "EXERCISE_RECOMMENDATION" | "DIET_RECOMMENDATION" | "PDF_SUMMARY"
  content       String
  engineUsed    String   @default("rule-based") // "rule-based" | "openai" — which AI backend produced this
  generatedAt   DateTime @default(now())
  generatedById String?
  generatedBy   User?    @relation(fields: [generatedById], references: [id])

  @@index([memberId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String // e.g. "member.create", "payment.record", "login"
  entityType String?
  entityId   String?
  detailJson Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// ---------- Naver 검색광고 자동화 ----------
// One connected 네이버 검색광고 (searchad.naver.com) advertiser account per row.
// secretKeyEnc holds the SECRET_KEY encrypted at rest (see lib/services/naverAds/crypto.ts) —
// never store it in plaintext since it signs requests that can move ad spend.
// autoExecute is a hard kill switch: even when a rule is `active`, the rule engine only
// applies live changes when the *account's* autoExecute is also true. Both default to
// false so nothing runs live until a staff member explicitly opts in twice.

model NaverAdAccount {
  id           String   @id @default(cuid())
  label        String // e.g. "OO필라테스 네이버광고"
  customerId   String // CUSTOMER_ID (광고주 고객번호)
  apiKey       String // ACCESS LICENSE (X-API-KEY)
  secretKeyEnc String // encrypted SECRET_KEY, format: base64(iv):base64(authTag):base64(ciphertext)
  autoExecute  Boolean  @default(false) // kill switch — false = proposals only, never calls write APIs
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id])

  rules            AdAutomationRule[]
  runLogs          AdRunLog[]
  keywordSnapshots AdKeywordSnapshot[]
}

model AdAutomationRule {
  id            String   @id @default(cuid())
  accountId     String
  account       NaverAdAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name          String
  ruleType      String // "BID_CEILING" | "PAUSE_NO_CONVERSION" | "DAILY_BUDGET_GUARD"
  targetLevel   String // "CAMPAIGN" | "ADGROUP"
  naverTargetId String // nccCampaignId or nccAdgroupId depending on targetLevel
  paramsJson    Json // rule-specific thresholds, e.g. { maxCpc, stepPercent, minBid, lookbackDays, costThreshold, dailyBudgetCap }
  active        Boolean  @default(false) // must be explicitly turned on per rule (in addition to account.autoExecute)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  runLogs AdRunLog[]

  @@index([accountId])
}

model AdRunLog {
  id         String            @id @default(cuid())
  accountId  String
  account    NaverAdAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  ruleId     String?
  rule       AdAutomationRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  mode       String // "SIMULATED" | "LIVE"
  outcome    String // "PROPOSED" | "APPLIED" | "SKIPPED" | "ERROR"
  summary    String
  detailJson Json?
  runAt      DateTime @default(now())

  @@index([accountId])
  @@index([runAt])
}

// Cached results of the 네이버 검색광고 키워드 도구 (파워링크 연관키워드 분석).
model AdKeywordSnapshot {
  id                    String          @id @default(cuid())
  accountId             String?
  account               NaverAdAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  keyword               String
  monthlyPcSearches     Int?
  monthlyMobileSearches Int?
  competitionLevel      String? // compIdx: "낮음" | "중간" | "높음"
  avgPcCtr              Float?
  avgMobileCtr          Float?
  avgAdDepth            Float? // plAvgDepth — 파워링크 평균 노출 광고 수 (경쟁 강도 참고용)
  capturedAt            DateTime @default(now())

  @@index([keyword])
  @@index([accountId])
}
